node_modules/
data/db.json

# Inspiration photos clients attach to their bookings. Private by definition:
# someone else's picture, sent to Chrissy for one appointment. They live
# outside public/ and are served only to a logged-in admin — committing them
# to a public repo would undo all of that in one push.
data/uploads/

# Backup archives. Same reasoning as data/ itself, only more so: one of these
# is the entire client list, their phone numbers, and their photos, in a single
# file that is easy to move somewhere it should not go.
backups/
*.tar.gz


.env
.DS_Store
*.log
.shots/

# MCP server config. Written by `claude mcp add -s project` and by the
# 21st.dev CLI, and can carry an API key in a plaintext header.
.mcp.json

# Other credential shapes, for the same reason as .env above
.env.*
*.pem
*.key
secrets.json

# Local Claude Code state, specific to one machine
.claude/settings.local.json
