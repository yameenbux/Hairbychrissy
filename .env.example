# Copy to .env and fill in. The app runs fine with none of these set (demo mode).
PORT=3000

# --- Where the bookings live ----------------------------------------------
# The bookings database AND the photos clients attach to them. Defaults to
# ./data, which is correct for a local checkout.
#
# IN PRODUCTION, POINT THIS AT A PERSISTENT DISK. Most hosts give a container
# a fresh filesystem on every deploy, so leaving this unset there means the
# site runs perfectly and loses every booking the next time you push. The
# startup banner prints this path and flags it when it is still the default.
#
#   Fly.io   fly volumes create hbc_data --size 1  ->  DATA_DIR=/data
#   Render   add a Disk, mount path /var/data      ->  DATA_DIR=/var/data
#   Railway  add a Volume, mount path /data        ->  DATA_DIR=/data
#   A VPS    any directory you back up             ->  DATA_DIR=/srv/hbc-data
#
# Not needed at all if you use Supabase below — that removes the disk entirely.
DATA_DIR=

# --- Supabase (optional, and the easier answer in production) --------------
# Set both and the app stores bookings in Postgres and client photos in
# Storage, instead of on disk. No volume to attach, survives every redeploy,
# and the bookings are readable in the Supabase table editor.
#
# Setup, once:
#   1. Run supabase/schema.sql in the SQL editor.
#   2. Storage -> New bucket -> "booking-photos", Public OFF.
#   3. Set the two values below (Settings -> API).
#   4. node tools/supabase-migrate.js --apply     (moves any existing data)
#
# SUPABASE_SERVICE_KEY is the SECRET key — shown as "sb_secret_..." in the
# current dashboard, or "service_role" in the older one. NOT the publishable
# key ("sb_publishable_...", previously "anon"), which is the one meant for
# browsers: this schema enables RLS with no policies, so a publishable key can
# read and write nothing and the app would fail on its first query.
# It bypasses row-level security,
# so it is a full-access credential: server only, never in a browser, never
# committed. It is not the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Storage bucket for the photos. Only change if you named it something else.
SUPABASE_BUCKET=booking-photos

# Admin dashboard password (Chrissy's login). CHANGE THIS BEFORE GOING LIVE.
ADMIN_PASSWORD=chrissy

# Secret used to sign the admin session cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Card payments (Stripe) ---
# Leave blank to run card payments in DEMO mode (a simulated card page, no real money).
# Add a real key to switch on live Stripe Checkout.
STRIPE_SECRET_KEY=
# Public base URL, used for Stripe success/cancel redirects.
PUBLIC_URL=http://localhost:3000

# --- Notifications ---------------------------------------------------------
# All optional. With none of these set, Chrissy still gets dashboard alerts and
# phone/desktop push (push needs no configuration — she just taps "enable" in
# the dashboard). Each extra channel below is an independent belt-and-braces.

# How long her dashboard sign-in lasts, in days. Longer means push notifications
# can show full booking detail for longer without a re-login.
ADMIN_SESSION_DAYS=14

# Contact URI sent to push services so they can report problems (mailto: or https:).
NOTIFY_CONTACT=

# Email — via Resend (https://resend.com), free tier is plenty.
#
# NOTIFY_EMAIL_TO is Chrissy's own inbox. It lives here and nowhere else:
# it is a personal address, and a personal address in a public repository is
# a personal address in a scraper's list within the week. Comma-separate to
# copy in a second address.
#
# NOTIFY_EMAIL_FROM works out of the box with Resend's shared sending domain,
# which is fine for testing. For real use, verify her own domain in Resend and
# send from it — mail from onboarding@resend.dev is far likelier to land in
# spam, and an alert in a spam folder is a missed booking.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=Bookings <onboarding@resend.dev>

# The morning run-down: one message each morning listing everything booked for
# that day. Set to the hour she wants it in her own timezone, 0-23 — 7 means
# "some time just after 07:00". Leave blank to switch it off.
#
# This is the alert most likely to catch a booking made three weeks ago and
# forgotten since, because unlike the others it does not depend on her having
# seen the notification at the moment it arrived.
DAY_AHEAD_HOUR=

# Webhook — works as-is with a Slack or Discord incoming webhook, Zapier or IFTTT.
NOTIFY_WEBHOOK_URL=

# Telegram — free instant push to her phone. Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Text message — via Twilio. Costs a few pence per message.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
NOTIFY_SMS_TO=

# --- Static front-end (GitHub Pages) ---------------------------------------
# If the site is published as flat files somewhere else (e.g. GitHub Pages) and
# talks back to this API, list that origin here so CORS allows it.
# Comma-separated, no trailing slash. Never set this to "*".
ALLOWED_ORIGINS=
